{
  "name": "cliper-desktop",
  "version": "0.3.2",
  "private": true,
  "description": "Cliper desktop app (Electron UI for the Rust engine)",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pack:win": "electron-vite build && electron-builder --win dir --config electron-builder.config.cjs",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "pack:cuda-addon": "node scripts/pack-cuda-addon.mjs",
    "test": "node --test src/renderer/lib/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "dependencies": {},
  "author": "Cliper"
}
